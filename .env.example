# Example environment for local development. Spring Boot does NOT read a .env file by itself:
# export these in your shell or set them in your IDE run configuration. Never commit real secrets.

# --- Backend (Spring Boot) ---
# Optional: with no profile the app runs as "local". Deployments set SPRING_PROFILES_ACTIVE=prod.
# Add "seed" (for example prod,seed) to create the demo HR Manager accounts once.
SPRING_PROFILES_ACTIVE=local

# Database connection (MariaDB). "local" falls back to these defaults; "prod" requires all three
# and refuses to start if any is missing. Use a strong, unique password outside local development.
DB_URL=jdbc:mariadb://localhost:3306/salary
DB_USER=salary
DB_PASSWORD=salary

# Token signing key, at least 32 bytes. Required in prod (the app refuses to start without it);
# local has a development-only default. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-value-of-at-least-32-bytes

# Origins allowed to call the API from a browser, comma separated. Required in prod.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Password given to the demo HR Manager accounts created by the local or seed profile.
# Required with the seed profile; local has a development-only default.
DEMO_HR_PASSWORD=change-me

# --- Frontend ---
# The API address is not an environment variable: it is read at startup from frontend/public/config.json
# (apiBaseUrl). Replace that file at deploy time to point the same build at another API.
