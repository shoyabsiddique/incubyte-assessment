# Copy to .env for local development. Never commit the real .env or any secret.

# --- Backend (Spring Boot) ---
# Spring profile: local | test | prod
SPRING_PROFILES_ACTIVE=local
# Database connection (MariaDB). local has defaults; prod requires all three.
DB_URL=jdbc:mariadb://localhost:3306/salary
DB_USER=salary
DB_PASSWORD=change-me
