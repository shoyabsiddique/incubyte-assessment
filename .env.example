# Example environment for local development. Spring Boot does NOT read a .env file by itself:
# export these in your shell or set them in your IDE run configuration. Never commit real secrets.

# --- Backend (Spring Boot) ---
# Optional: with no profile the app runs as "local". Deployments set SPRING_PROFILES_ACTIVE=prod.
SPRING_PROFILES_ACTIVE=local

# Database connection (MariaDB). "local" falls back to these defaults; "prod" requires all three
# and refuses to start if any is missing. Use a strong, unique password outside local development.
DB_URL=jdbc:mariadb://localhost:3306/salary
DB_USER=salary
DB_PASSWORD=salary
